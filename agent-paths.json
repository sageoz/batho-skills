      "global_dirs": ["~/.codex/skills"],
      "windows_global_dirs": ["%USERPROFILE%\\.codex\\skills"],
      "notes": "~/.codex/skills deprecated but scanned; canonical user dir is ~/.agents/skills; /etc/codex/skills is admin scope (not written by installers)"
    },
    "gemini": {
      "display": "Gemini CLI",
      "reads_agents_dir": true,
