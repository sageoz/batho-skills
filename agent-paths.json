{
  "_schema": {
    "version": 1,
    "description": "Canonical per-agent skill-directory table for the Batho skill pack installers. Consumed by install.sh (embedded rendering), install.ps1 (ConvertFrom-Json), and skills/batho-setup/scripts/install_pack.py. Install strategy: always write canonical <scope>/.agents/skills; for agents with reads_agents_dir=false also mirror into their native dirs when detected (marker exists) or forced via --agent/--all.",
    "fields": {
      "reads_agents_dir": "agent discovers <scope>/.agents/skills natively — no mirror required",
      "detect": "markers whose existence means the agent is installed (global dirs under $HOME; project dirs relative to project root)",
      "project_dirs": "native skill dirs relative to project root (written when detected/forced; informational when reads_agents_dir=true)",
      "global_dirs": "native skill dirs under $HOME / %USERPROFILE% (posix form; windows override where noted)",
      "windows_global_dirs": "Windows-specific global paths (env-var form; substituted at runtime)"
    }
  },
  "pack_skills": ["batho", "batho-setup", "batho-specs", "batho-execute", "batho-review"],
  "canonical": {
    "project": ".agents/skills",
    "global_posix": "~/.agents/skills",
    "global_windows": "%USERPROFILE%\\.agents\\skills"
  },
  "agents": {
    "claude-code": {
      "display": "Claude Code",
      "reads_agents_dir": false,
      "detect": {"global_dirs": ["~/.claude"], "project_dirs": [".claude"], "bins": ["claude"]},
      "project_dirs": [".claude/skills"],
      "global_dirs": ["~/.claude/skills"],
      "windows_global_dirs": ["%USERPROFILE%\\.claude\\skills"]
    },
    "cursor": {
      "display": "Cursor",
      "reads_agents_dir": true,
      "detect": {"global_dirs": ["~/.cursor"], "project_dirs": [".cursor"], "bins": ["cursor"]},
      "project_dirs": [".cursor/skills"],
      "global_dirs": ["~/.cursor/skills"],
      "windows_global_dirs": ["%USERPROFILE%\\.cursor\\skills"]
    },
    "copilot": {
      "display": "GitHub Copilot",
      "reads_agents_dir": true,
      "detect": {"global_dirs": ["~/.copilot"], "project_dirs": [".github"], "bins": ["copilot"]},
      "project_dirs": [".github/skills"],
      "global_dirs": ["~/.copilot/skills"],
      "windows_global_dirs": ["%USERPROFILE%\\.copilot\\skills"]
